        "src/chapter.js#shen_space"
      ],
      "hash": "c521707ca8ea9ef0ca6212e69a199ecbf71cdefe37c78f8ac22ca98a32748827",
      "status": "cached"
    },
    {
      "actor": "qing",
      "text": "花石能进京，脚夫的工钱却不能少。这批名册在符祥的鸟笼底下。",
      "sources": [
        "src/chapter.js#convoy_dispute"
      ],
      "hash": "c75b08dff626f95b90c2c667b6b00b311fd807203116f987a272b9122a5712df",
      "status": "cached"
    },
    {
      "actor": "qing",
      "text": "工钱先垫上，收据两边各留一份。花石送进京，也得有人记得抬石头的人。",
      "sources": [
        "src/chapter.js#convoy_peace"
      ],
      "hash": "1c93bd1c81629c6f1ef2b9f838cae026d18463f8fa8457d48fb25b9fa905ea45",
      "status": "cached"
    },
    {
      "actor": "chi",
      "text": "我们押货，他们护路，都是吃这口饭。应奉局一文不出，倒叫我们两边打。",
      "sources": [
        "src/chapter.js#convoy_dispute"
      ],
      "hash": "16951ab2975b33e71a013fb74835979c3f0aa1c3b589477f87e57adf898b5987",
      "status": "cached"
    },
    {
      "actor": "chi",
      "text": "工钱先垫上，收据两边各留一份。花石送进京，也得有人记得抬石头的人。",
      "sources": [
        "src/chapter.js#convoy_peace"
      ],
      "hash": "591e6dd61c0560298c2ec122677bdc1e20638867528713dd8392beadbd3935b1",
      "status": "cached"
    },
    {
      "actor": "thief",
      "text": "是我。偷来的钱袋还没花。你要送我见官，还是让我把东西还回去？",
      "sources": [
        "src/chapter.js#yan_secret"
      ],
      "hash": "2337c6223ef4045f128e4b3b10ac92fcb1fcb3bc0ea2e3c0cd882a08c5de570d",
      "status": "cached"
    },
    {
      "actor": "thief",
      "text": "这回算欠你的。袖口的活我能教；至于赤砂堂，我替你递个话。",
      "sources": [
        "src/chapter.js#yan_release"
      ],
      "hash": "00b4c1b41f12402647c927eedcdf0398187076ddb49eced3c02aae4a5b1affd1",
      "status": "cached"
    },
    {
      "actor": "porter",
      "text": "人手够了。纲货出了错，谁担着？",
      "sources": [
        "src/convoy.js#work:0"
      ],
      "hash": "02294d8326efcd49b1cc37b888fc9d1f1809712c2804b65cfc631d991c36ef2f",
      "status": "cached"
    },
    {
      "actor": "porter",
      "text": "这份心意我领了。行，你算一个；换好短褂，别碰车上的纲货。",
      "sources": [
        "src/convoy.js#bribe:0"
      ],
      "hash": "90a42fabc183e722f5037d3e8a86e55bf2f191af3d957f8929a44f9a8c12495b",
      "status": "cached"
    },
    {
      "actor": "porter",
      "text": "话说得倒动听。好，给你留个位置；上工还得换短褂，车上的纲货别动。",
      "sources": [
        "src/convoy.js#charm:0"
      ],
      "hash": "4d5c509d6c40634977d4072ba6d25b92338ff78a9114a9f3ff2ef0b5da206b1d",
      "status": "cached"
    },
    {
      "actor": "porter",
      "text": "好话我听了，可这份差事不能凭一句好话就应下。",
      "sources": [
        "src/convoy.js#charm:0.99"
      ],
      "hash": "7da3d731234abcafc609a911bc07f7c940bafb284a40a61ef4701100ebfd3b5f",
      "status": "cached"
    },
    {
      "actor": "porter",
      "text": "衣着齐整了，跟上。进关后把车送到镇公所门前。",
      "sources": [
        "src/convoy.js#CONVOY_ENTRY_LINE"
      ],
      "hash": "e5330d4dc892046a1e6af6e8423c911d9ca9d0d24ff250f8ceaa495e736f9c73",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "驿舍补衣人这两日在补一身旧差衣，说补好了要交还关上。",
      "sources": [
        "src/event-deck.js#uniform_rack"
      ],
      "hash": "1892dcb7e202b05bf265767e991888a501a976001d6a89c17459d0e2a4e45e28",
      "status": "cached"
    },
    {
      "actor": "old_constable",
      "text": "驿舍那身皂衣，补了三日还没补完。",
      "sources": [
        "src/event-deck.js#uniform_rack"
      ],
      "hash": "de92c8f2cf2b26e5f0e95e551e51770e3f07496666f1d4cb6d55c61664d56d43",
      "status": "cached"
    },
    {
      "actor": "gate_merchant",
      "text": "驿舍衣架上挂着差衣，我还当里头有差爷歇脚。",
      "sources": [
        "src/event-deck.js#uniform_rack"
      ],
      "hash": "caaa69a79fee83a3c96854956a3d35414fc7428002fa20027e07af0c853c63be",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "赵行商每回喝茶都要摸一摸胸口，说路引比命金贵。",
      "sources": [
        "src/event-deck.js#merchant_pass"
      ],
      "hash": "4a1a0996eb61630cf70059826de2b0ac6436b37af970a76d791dccba9bed0105",
      "status": "cached"
    },
    {
      "actor": "scribe",
      "text": "赵行商那张路引我见过，印是真的，名字写的赵成。",
      "sources": [
        "src/event-deck.js#merchant_pass"
      ],
      "hash": "65f5fed3e1594444f795bd6448c963676b5e026625708c2ec8ecf8188ff36889",
      "status": "cached"
    },
    {
      "actor": "relay",
      "text": "那行商的路引收得紧，换衣裳都不离身。",
      "sources": [
        "src/event-deck.js#merchant_pass"
      ],
      "hash": "a17ed2653cfca1ba252528860f28ed8e779ebe4aaaf477b9ad05a45c4fc9644c",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "役夫的名额归周大石管。他肯带谁，自有他的考量，你去问问。",
      "sources": [
        "src/event-deck.js#merchant_escort"
      ],
      "hash": "73b1b86ea06789f2395afb21c892c4343318731455afcbd0a145fd6a4d8a2be8",
      "status": "cached"
    },
    {
      "actor": "old_constable",
      "text": "那位锦衣客在茶棚。关口的事，你可问问他。",
      "sources": [
        "src/event-deck.js#guard_vouch"
      ],
      "hash": "0fe36c6f7fe38c2a81d9b44a8eb241ffe812345b61371eb6899456b4ecc6d68d",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "那位锦衣客还在茶棚。你有话，可以当面问他。",
      "sources": [
        "src/event-deck.js#guard_vouch"
      ],
      "hash": "ea565ec3c8d1742abccf0994f05b4d30245882b7e8315098aeb4d7deb6093a98",
      "status": "cached"
    },
    {
      "actor": "old_constable",
      "text": "西边那道河栅泡了十几年，木头早糟了。",
      "sources": [
        "src/event-deck.js#river_fence"
      ],
      "hash": "b63a4da5c42102b05c37d76318c9316f4dc8b10d3bd8f8210af63be24f5c61b0",
      "status": "cached"
    },
    {
      "actor": "relay",
      "text": "河边那道木栅，晾衣时看着都歪了。",
      "sources": [
        "src/event-deck.js#river_fence"
      ],
      "hash": "23003c59787f48a5a0d342e6f27b4ea6b1a417fe318922e41370689a42a0a73c",
      "status": "cached"
    },
    {
      "actor": "gate_relief",
      "text": "西边水栅年年报修，年年没钱换。",
      "sources": [
        "src/event-deck.js#river_fence"
      ],
      "hash": "6bd87fffe7af43fdd76df6271b11df387993011e9ce6cf3061a816daa66817ce",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "那位穿锦衣的客人从早坐到现在，茶都凉了三回。",
      "sources": [
        "src/event-deck.js#prince_waiting"
      ],
      "hash": "8b2094683a5a656b531450a302cb49daa983383b9204b9af9ac3a95f25c9e244",
      "status": "cached"
    },
    {
      "actor": "gate_merchant",
      "text": "茶棚那位锦衣客，腰上的玉我在汴京也少见。",
      "sources": [
        "src/event-deck.js#prince_waiting"
      ],
      "hash": "511b6fe053a6bd827cb19e0402dc38919cbc97dfca5271db54d7e7b134d7a42a",
      "status": "cached"
    },
    {
      "actor": "gate_relief",
      "text": "杜老捕拿人不用蛮力，手往筋骨上一搭，人就不动了。",
      "sources": [
        "src/event-deck.js#footwork"
      ],
      "hash": "ee5eb5a3e6c1eab0976d1929b8ac7e1d166d69ce59365117c2842801923ba19d",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "杜老捕那双手，拿过人，也救过人。",
      "sources": [
        "src/event-deck.js#footwork"
      ],
      "hash": "a6aa26040080ada8bab7443740b2163ddc349a2715d00917436b11dae8e3a2b1",
      "status": "cached"
    },
    {
      "actor": "old_constable",
      "text": "西墙那瘸子看人很准。你问他刻字人的手。",
      "sources": [
        "src/event-deck.js#seal_lesson"
      ],
      "hash": "0364c6360802d6a8133f39a21f8bd460ed7ad3b12898c230838bf267fc951519",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "刻字师傅不肯挽袖。瘸张瞧过一眼，没再问。",
      "sources": [
        "src/event-deck.js#seal_lesson"
      ],
      "hash": "42d26cece74d5e54ebbce113ddb3673910f64e48962f9211e05d8627d058ed7b",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "赵行商一早要的饼还没送到，饿得直转圈。",
      "sources": [
        "src/event-deck.js#merchant_hungry"
      ],
      "hash": "42faa161ae9d90192257f5f114ceac9eb3956e436875d52f1d4462935c25894e",
      "status": "cached"
    },
    {
      "actor": "relay",
      "text": "那行商在门口转了半日，说是等饼。",
      "sources": [
        "src/event-deck.js#merchant_hungry"
      ],
      "hash": "be8fc2e786193fb1b5f724a2dcd39c1ab3ee42294cf773d48f9b7f55bc240140",
      "status": "cached"
    },
    {
      "actor": "old_constable",
      "text": "那刻字的握刀的架势，不是刻印练出来的。",
      "sources": [
        "src/event-deck.js#scribe_hands"
      ],
      "hash": "69fb4174c9e70035a87a91cd002b61001ba11f0439b1938ab9d082e82a16cc8d",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "刻字师傅搬货那天，一肩扛起两只箱子。",
      "sources": [
        "src/event-deck.js#scribe_hands"
      ],
      "hash": "f2faca3fb2c791d94e8ae399a1b8563b1f29a2b4f0f8101ed16b99e76f690d53",
      "status": "cached"
    },
    {
      "actor": "gate_relief",
      "text": "榜上那个燕七，城里丢了东西的都报他。",
      "sources": [
        "src/event-deck.js#thief_bounty"
      ],
      "hash": "c97cbc009816dcf7b2175e6ed551a351e0cc6794c9959527f857b8904c01072c",
      "status": "cached"
    },
    {
      "actor": "old_constable",
      "text": "燕七那小子我抓过两回，手快，心倒不坏。",
      "sources": [
        "src/event-deck.js#thief_bounty"
      ],
      "hash": "11d34cba4538358a790641311454fc99bd46f7fd31d797d1e030559cd00f6b93",
      "status": "cached"
    },
    {
      "actor": "inn",
      "text": "顾大人选人，肯接手难事的，他都留心。",
      "sources": [
        "src/event-deck.js#court_hiring"
      ],
      "hash": "9dad57ef946ed4c004d85ee31be031d5ac3882714e7f52767354e5898ff4deb0",
      "status": "cached"
    },
    {
      "actor": "guard",
      "text": "榜上那燕七能带回来，大堂就认你这一份功。",
      "sources": [
        "src/event-deck.js#court_hiring"
      ],
      "hash": "054ffb951a6b7d4154b5f2917ea233d2469413930fae4bf1bfb9776ffcbeee6c",
      "status": "cached"
    },
    {
      "actor": "chi",
      "text": "你肯替脚夫说话，梅掌舵便肯听你说话。",
      "sources": [
        "src/event-deck.js#gang_den"
      ],
      "hash": "4fb2879a8d5c063b75f39a4a7df575c23c0e3383ba5cba719e7e1d438f34a461",
      "status": "cached"
    },
    {
      "actor": "porter",
      "text": "燕七和赤砂堂有来往。找活路的人，彼此都认得。",
      "sources": [
        "src/event-deck.js#gang_den"
      ],
      "hash": "b22313e2aa02a6bbf53809a9231855d1f49f4991b3a9bc372e7882f102990f71",
      "status": "cached"
    },
    {
      "actor": "inn",
      "text": "抄账的被关了，说是看见花石纲的账对不上。",
      "sources": [
        "src/event-deck.js#ledger_rumor"
      ],
      "hash": "4fad0bcd0bcf18940c2bf9bedd40e15dc24583494535d247495436d26cbd8084",
      "status": "cached"
    },
    {
      "actor": "elder",
      "text": "县狱里那位账房，进去时袖中还护着一本账。",
      "sources": [
        "src/event-deck.js#ledger_rumor"
      ],
      "hash": "4ebd24edd5925ccf9253f523780a88db073e446eefeef712235182d76dd4c258",
      "status": "cached"
    },
    {
      "actor": "qing",
      "text": "沈师兄的戒指和苏姑娘的心事，哪里是同一回事。",
      "sources": [
        "src/event-deck.js#proposal"
      ],
      "hash": "afa751f96bdc568a165076392bd9e709ea9eb066b2daf2f6383b72c2830642c3",
      "status": "cached"
    },
    {
      "actor": "gao",
      "text": "桥头那两位还没谈妥。苏姑娘想走自己的路。",
      "sources": [
        "src/event-deck.js#proposal"
      ],
      "hash": "2b3e0dde25d20fa0201cbe1343ef82a3e2ce1cd5f5bbeee58d7fe233824da623",
      "status": "cached"
    },
    {
      "actor": "tea",
      "text": "苏姑娘的笛子好听，可总有人不肯听她说话。",
      "sources": [
        "src/event-deck.js#su_music"
      ],
      "hash": "7eda6da14feed0530947f23c0275b947421841517e3ae76b80d025ea9d808b4c",
      "status": "cached"
    },
    {
      "actor": "gao",
      "text": "苏晚说要唱自己的曲子，我觉得没什么不好。",
      "sources": [
        "src/event-deck.js#su_music"
      ],
      "hash": "75b4c8c9d4e8d9d5c3a48ea40665ff21a5d32bbd1e8ba31a6b92466db22af067",
      "status": "cached"
    },
    {
      "actor": "porter",
      "text": "脚夫扭了脚，都找阿青敷药。",
      "sources": [
        "src/event-deck.js#aqing_herbs"
      ],
      "hash": "73c777bdc2008996ecd593e53cf7e1ff7be086c39aff7b7f9f21e0843e70c34b",
      "status": "cached"
    },
    {
      "actor": "inn",
      "text": "阿青一直给伤者敷药，药账却还欠着。",
      "sources": [
        "src/event-deck.js#aqing_herbs"
      ],
      "hash": "b9ff5ad531207262f99f734a79f24d3d454e6b00a04c67fd5210d610a8c3a5cc",
      "status": "cached"
    },
    {
      "actor": "guard",
      "text": "燕七那小子又出手了，捕房里堆着状子。",
      "sources": [
        "src/event-deck.js#thief_town"
      ],
      "hash": "1331a14611b9d16d18dc505121b05cf15a7058a36b4f619f9cab25739f28cd5d",
      "status": "cached"
    },
    {
      "actor": "merchant",
      "text": "燕七又在街上转，我把钱袋缝进了里衣。",
      "sources": [
        "src/event-deck.js#thief_town"
      ],
      "hash": "6fe91122b567c7017477783146409eb3e292b7f46864b9ab1f2f1369218aadc1",
      "status": "cached"
    }
  ],
