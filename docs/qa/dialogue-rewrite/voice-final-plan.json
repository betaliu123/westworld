      "hash": "8d15cd235d4e195dfb50d4abc6a2ca1fad4e64da8006871fa56a5d351c368f06",
      "status": "cached"
    },
    {
      "actor": "prisoner",
      "text": "账抄了两份，数却不一样。我多问了一句，就到了这里。",
      "sources": [
        "src/chapter-speech.js#ledger_story"
      ],
      "hash": "1c4e4460aa371ee77c9f072a80bbf0c8419fbfb0f06f90929eb346478886ba99",
      "status": "cached"
    },
    {
      "actor": "prisoner",
      "text": "花石纲的副账。我留着原本。",
      "sources": [
        "src/chapter-speech.js#ledger_where"
      ],
      "hash": "f4d641fedfe00dabc15bbf60fe5f319aac9997db0bee6715230f9286acba17a5",
      "status": "cached"
    },
    {
      "actor": "prisoner",
      "text": "给你。我盼有人肯查。我说的话，得拿账去对。",
