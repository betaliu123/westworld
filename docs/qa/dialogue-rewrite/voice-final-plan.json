    },
    {
      "actor": "gate_merchant",
      "text": "赵成。东溪来的。",
      "sources": [
        "src/chapter-speech.js#merchant_name"
      ],
      "hash": "68670e6ea0331faefbfe773a1a7ad1a68f237587c2a7dad6f3d9e1185fac3c02",
      "status": "cached"
    },
    {
      "actor": "gate_merchant",
      "text": "韩校尉认得我。今日也没放松查。",
      "sources": [
        "src/chapter-speech.js#merchant_guard"
      ],
      "hash": "3b878b1e5f6f19b435953b91efcbb5fb1189bdd5614fc470482a9e372bd150f9",
      "status": "cached"
    },
    {
      "actor": "relay",
      "text": "陈小乙。原先替驿站跑腿的。",
      "sources": [
        "src/chapter-speech.js#runner_name"
      ],
      "hash": "8ea85c67cd14fa9fca24680c8f29604bf1b189dfe643af82944dab41793ce764",
      "status": "cached"
    },
    {
      "actor": "relay",
      "text": "六文。袖口刚补过。",
      "sources": [
        "src/chapter-speech.js#clothes_price"
      ],
      "hash": "e792aff82975b0bda76e9d405d9cc603374bffdba9596603a27d14a65582f930",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "茶还卖着，差费倒先催上了。",
      "sources": [
        "src/chapter-speech.js#tea_worry"
      ],
      "hash": "a0dac9c299424177120bc8898c5f3241b79a2fa8d63fe4db4cb851844c63150b",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "应奉局催的，两文。茶棚也躲不过。",
      "sources": [
        "src/chapter-speech.js#tea_fee"
      ],
      "hash": "7e581073ecb7bd88c98436ba6ce50fbcd9e86fb9b7af60653005080dd39d0cff",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "应奉局惦记上她的琴了。做娘的，哪能放心。",
      "sources": [
        "src/chapter-speech.js#tea_daughter"
      ],
      "hash": "0cfa4221faa9ce2e52e8b75e0172772441dfe7b17a0cd398a546a452c5e076ca",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "驿舍那边刚补好一身旧差服。",
      "sources": [
        "src/chapter-speech.js#tea_coat"
      ],
      "hash": "3add8ca1cc83999d16cf590bb4206f3c9cac19ed17b3c0d7b9bf6ca8491ba6a8",
      "status": "cached"
    },
    {
      "actor": "tea_host",
      "text": "抬箱的人归周大石管。他在车旁。",
      "sources": [
        "src/chapter-speech.js#tea_porter"
      ],
      "hash": "498892d82c94e456674b891377734fdf845e0dbb766e331bc6c4de713385fcaf",
      "status": "cached"
    },
    {
      "actor": "scribe",
      "text": "眼睛倒尖。针囊认得，规矩也该懂。",
      "sources": [
        "src/chapter-speech.js#scribe_secret"
      ],
      "hash": "d98d1b8d867e17c4a73e2cf83986de60253e7e249c7ace7fc26642c377980af2",
      "status": "cached"
    },
    {
      "actor": "scribe",
      "text": "五文。收好了，别混进伤药。",
      "sources": [
        "src/chapter-speech.js#poison_price"
      ],
      "hash": "f434467a4ab86864bf07d4ea5ff0c7c95d434f7909936ef6b38f57870e745233",
      "status": "cached"
    },
    {
      "actor": "traveler",
      "text": "阁下也在等进城？坐着，也能看见些事。",
      "sources": [
        "src/chapter-speech.js#royal_intro",
        "src/voice-lines.js#VOICE_TRIAL"
      ],
      "hash": "a8a1ede32c40be418396fe25a570d03da11f8251a959c47e7467ac4b6049f32a",
      "status": "cached"
    },
    {
      "actor": "traveler",
      "text": "赵闲舟。出门用的名字。",
      "sources": [
        "src/chapter-speech.js#royal_name"
      ],
      "hash": "9c7e579280c9afbb994e36f2904dd12402843ad1792b0bcbbf65d97394771cfb",
      "status": "cached"
    },
    {
      "actor": "traveler",
      "text": "方才那两文，我看见了。我替你向关上说一句。",
      "sources": [
        "src/chapter-speech.js#royal_offer"
      ],
      "hash": "54365b9b9a1749c4ad47a4236131a83a0dd4939c56a72d0bc09a3002c27e18b1",
      "status": "cached"
    },
    {
      "actor": "traveler",
      "text": "我有事相托，你再听听。不是卖身契。",
      "sources": [
        "src/chapter-speech.js#royal_terms"
      ],
      "hash": "53d35f31ddd9428ff96a10aa727a8530ca61ae4abf90ef7a016ab6c24f9aff1e",
      "status": "cached"
    },
    {
      "actor": "traveler",
      "text": "你也进城了。路上可还顺利？",
      "sources": [
        "src/chapter-speech.js#entry_story"
      ],
      "hash": "2fb9cece87705dc5675774f4c88a438e66b8ea8d1a974f07b384aed9a4f7a30a",
      "status": "cached"
    },
    {
      "actor": "traveler",
      "text": "我想查花石纲的副账。你肯帮我留意么？",
      "sources": [
        "src/chapter-speech.js#royal_task_offer"
      ],
      "hash": "c5bd6772700497323bd7d7c06b8c21f4a42975ad77ffbe2c4e55b1442b209615",
      "status": "cached"
    },
    {
      "actor": "qinghe",
      "text": "我想去京里听听，那些曲子怎么唱。",
      "sources": [
        "src/chapter-speech.js#qinghe_wish"
      ],
      "hash": "35b4179b864c39b7cbb0af4a83ae2e124887073aafb1be5adc47803493cffd59",
      "status": "cached"
    },
    {
      "actor": "qinghe",
      "text": "想去，不等于任人把名字填上。",
      "sources": [
        "src/chapter-speech.js#qinghe_boundary"
      ],
      "hash": "98684ac5b107c42ec25be0fc64ada4fbea3b0bbd2844d1f96c7d06fea3aa6359",
      "status": "cached"
    },
    {
      "actor": "qinghe",
      "text": "是我的名字。他们竟先写好了。",
      "sources": [
        "src/chapter-speech.js#list_show"
      ],
      "hash": "684dc2da3f454ceb5ab540423540c05b0667c3e80a314d2b56c8bfb29edd479e",
      "status": "cached"
    },
    {
      "actor": "qinghe",
      "text": "我想去，也要自己选日子。你替我去，先说清替我做什么。",
      "sources": [
        "src/chapter-speech.js#qinghe_alternative"
      ],
      "hash": "35ac81402c932e6f441efb92ed86cb472d05a7264995dafabf61c016ef1a6bae",
      "status": "cached"
    },
    {
      "actor": "qinghe",
      "text": "让我再想一想。也请你别替我应下。",
      "sources": [
        "src/chapter-speech.js#qinghe_pause"
      ],
      "hash": "b94e33c9dcbfff443fb807d2a5f99aa71032a582c2dd1660203225bad4427a1c",
      "status": "cached"
    },
    {
      "actor": "shen",
      "text": "戒指还没找着，她又不肯听我说。",
      "sources": [
        "src/chapter-speech.js#shen_concern"
      ],
      "hash": "41b9e5b3bda4c5f6e35fe92f272d363c200f74edacb093504249adb06ef9fc30",
      "status": "cached"
    },
    {
      "actor": "su",
      "text": "我想唱自己的曲子。去京城，也要自己走去。",
      "sources": [
        "src/chapter-speech.js#su_wish"
      ],
      "hash": "3c3d2a1576b71d0c8c18e4963bda39e7fa478294961bfc78b40beaa067a6deca",
      "status": "cached"
    },
    {
      "actor": "su",
      "text": "戒指还回来，我收着。亲事，我还没答应。",
      "sources": [
        "src/chapter-speech.js#su_boundary"
      ],
      "hash": "cc594f051319a19e040c4fa72655b66253d3a041495202678abd20d704bd62a9",
      "status": "cached"
    },
    {
      "actor": "fu",
      "text": "应奉局定的名册。我只管按册交人交货。",
