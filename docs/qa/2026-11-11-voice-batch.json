      "duration": 6.876
    },
    {
      "actor": "porter",
      "text": "人手够了，不招了。纲货出了岔子，谁也担不起。",
      "sources": [
        "src/convoy.js#work:0"
      ],
      "hash": "94a83a011add08067bdeed1f5aabe35e4b174f0c7cf4b4e09dafedb1a3e2d8f8",
