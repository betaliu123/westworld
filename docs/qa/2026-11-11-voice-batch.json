      "duration": 4.284
    },
    {
      "actor": "porter",
      "text": "这份心意我领了。行，你算一个；换好短褂，别碰车上的纲货。",
      "sources": [
        "src/convoy.js#bribe:0"
      ],
      "hash": "90a42fabc183e722f5037d3e8a86e55bf2f191af3d957f8929a44f9a8c12495b",
