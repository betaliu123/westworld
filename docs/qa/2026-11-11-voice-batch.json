      "url": "/assets/audio/npc/c75b08dff626f95b90c2c667b6b00b311fd807203116f987a272b9122a5712df.mp3",
      "duration": 7.848
    },
    {
      "actor": "qing",
      "text": "工钱先垫上，收据两边各留一份。花石送进京，也得有人记得抬石头的人。",
      "sources": [
        "src/chapter.js#convoy_peace"
      ],
      "hash": "1c93bd1c81629c6f1ef2b9f838cae026d18463f8fa8457d48fb25b9fa905ea45",
