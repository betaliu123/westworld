      "duration": 7.74
    },
    {
      "actor": "porter",
      "text": "好话我听了，可这份差事不能凭一句好话就应下。",
      "sources": [
        "src/convoy.js#charm:0.99"
      ],
      "hash": "7da3d731234abcafc609a911bc07f7c940bafb284a40a61ef4701100ebfd3b5f",
